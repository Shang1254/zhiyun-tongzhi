# 知云同职 · 环境变量示例（复制为 .env 或填进云平台控制台）

## 基础
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TZ=Asia/Shanghai

## 数据目录（云上建议挂持久盘后指向该目录）
# ZY_DATA_DIR=/data

## 对外地址（可选，用于日志与生成绝对链接）
# PUBLIC_BASE_URL=https://zhiyun.example.com

## 限流（公益站点防滥用，可按需放宽）
ZY_RATE_LIMIT=120
ZY_WRITE_LIMIT=20

## 反代场景取真实 IP；不经过反代（直连）时设为 0
TRUST_PROXY=1

## 部署在不支持长驻的免费实例上时关闭定时任务
# ZY_DISABLE_CRON=1

## 管理接口令牌（公网部署必设）
## 作用：/api/admin/run-now（手动触发采集/复检/推荐）与 /api/jobs/import（岗位导入）
## 不设时只允许本机直连调用；设置后请求头带 x-admin-token: <值>
# ZY_ADMIN_TOKEN=换成随机长字符串
